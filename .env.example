# ---- Providers (BYOK — set both channels; mixed mock/real configs refuse to boot) ----
# Keyless recommended pair (ChatGPT login, no API key): run `codex login` once.
IMAGE_PROVIDER=codex           # codex | mock | openai | fal
LLM_PROVIDER=codex             # codex | mock | openai
# mock = offline placeholder mode (labeled "Chế độ thử nghiệm" in the UI) — fine for demos/CI.

# ---- Codex CLI channel (Sign in with ChatGPT; uses your plan quota) ----
CODEX_BIN=codex
# Pinned per invocation (--ignore-user-config + -m): never inherit the user's config.toml model.
CODEX_LLM_MODEL=gpt-6-luna     # planner model (text-only exec)
CODEX_IMAGE_MODEL=gpt-6-luna   # image-path model ($imagegen)
CODEX_REASONING_EFFORT=low
# Timeout budgets (TP.5): pre-flight 10s + planner 120s + image 300s + 30s margin = 480s
CODEX_PLANNER_TIMEOUT_MS=120000
CODEX_IMAGE_TIMEOUT_MS=300000

# ---- OpenAI API (BYOK alternative; edits path pins input_fidelity high) ----
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst   # one pinned model for generations AND edits

# ---- fal.ai (BYOK) ----
FAL_KEY=
FAL_MODEL=fal-ai/flux/schnell

# ---- Infra (docker compose defaults) ----
DATABASE_URL=postgres://oia:oia@localhost:5432/oia
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=oia
S3_SECRET_KEY=oia-secret
S3_BUCKET=oia
