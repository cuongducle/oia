# ---- BYOK: fill in the provider keys you have (leave blank to use the mock provider) ----
IMAGE_PROVIDER=mock            # mock | codex | openai | fal | replicate | comfyui
# codex = $imagegen via the Codex CLI (Sign in with ChatGPT) — no API key needed:
#   run `codex login` once, then set IMAGE_PROVIDER=codex. Uses your ChatGPT plan quota.
CODEX_BIN=codex
OPENAI_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
COMFYUI_URL=

LLM_PROVIDER=mock              # mock | openai | openrouter | ollama
OPENROUTER_API_KEY=
OLLAMA_URL=

# ---- Infra (docker compose defaults) ----
DATABASE_URL=postgres://pixforge:pixforge@localhost:5432/pixforge
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=pixforge
S3_SECRET_KEY=pixforge-secret
S3_BUCKET=pixforge
