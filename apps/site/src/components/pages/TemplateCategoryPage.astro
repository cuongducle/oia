---
import Page from '../../layouts/Page.astro'
import TemplateCard from '../TemplateCard.astro'
import TemplateFaq from '../TemplateFaq.astro'
import DownloadButtons from '../DownloadButtons.astro'
import { byCategory, byStyle, byPack, type Entry } from '../../data/catalog'
import { viLabel } from '../../data/locale-labels'

type Kind = 'category' | 'style' | 'pack'
interface Props { locale?: 'en' | 'vi'; base: string; kind: Kind; slug: string; label: string; path: string }
const { locale = 'en', base, kind, slug, label: enLabel, path } = Astro.props
const vi = locale === 'vi'
const t = (en: string, vn: string) => vi ? vn : en
const vbase = vi ? (base.replace('../', '') || './') : base
const list: Entry[] = kind === 'category' ? byCategory(slug) : kind === 'style' ? byStyle(slug) : byPack(slug)
const label = vi ? viLabel(slug) : enLabel
const title = kind === 'category'
  ? (vi ? `Mẫu ${label}` : `${label} templates`)
  : (vi ? `${label} · mẫu thiết kế` : `${label} ${kind === 'style' ? 'style templates' : 'template pack'}`)
const description = kind === 'category'
  ? t(
    `${list.length} editable ${enLabel.toLowerCase()} templates included in Oia v0.6.1. Real scenes, native text layers, no image quota needed to open or edit.`,
    `${list.length} mẫu ${label} sửa được, đi kèm Oia v0.6.1. Cảnh thật, lớp chữ thật, mở và sửa không tốn lượt AI.`)
  : t(
    `${list.length} real editable scenes from the ${enLabel} collection, bundled with Oia v0.6.1. Choose a composition, change the copy, and export.`,
    `${list.length} cảnh thật sửa được trong bộ ${label}, đi kèm Oia v0.6.1. Chọn composition, đổi chữ rồi xuất file.`)
---
<Page
  title={title}
  description={description}
  ogTitle={`${title} | Oia`}
  ogDescription={description}
  canonical={`https://oia.solutions/${vi ? 'vi/' : ''}templates/${path}`}
  base={base} locale={locale} route={`templates/${path}`}
>
<header class="pageHero">
  <p class="kicker">{t('The bundled library', 'Thư viện đi kèm')}</p>
  <h1>{title}</h1>
  <p class="lede">{t('Real scenes, editable text, no AI quota to open or edit.', 'Cảnh thật, chữ sửa được, mở và sửa không tốn lượt AI.')}</p>
  <DownloadButtons rowClass="ctaRow" anchorId="download" installHref={`${vbase}install/`} locale={locale} ghost={{ href: `${vbase}templates/`, label: t('All 35 templates', 'Xem đủ 35 mẫu') }} />
</header>

<main class="pageMain">
  <div class="tplGrid">
    {list.map((item) => <TemplateCard item={item} base={base} />)}
  </div>
  <TemplateFaq locale={locale} />
</main>
</Page>
