---
// Direct downloads stay available for both platforms, including without JS.
// Version facts live ONLY in src/data/releases.json; public/main.js carries a
// parallel runtime FALLBACK that config/audit/marketing-assets.py forces to
// match this file, so a release bump cannot update one and miss the other.
import release from '../data/releases.json'

const RELEASES = 'https://github.com/cuongducle/oia/releases'
const mib = (bytes: number) => `${Math.round(bytes / 1048576)} MiB`
const macHref = `${RELEASES}/download/${release.tag}/${release.mac.name}`
const winHref = `${RELEASES}/download/${release.tag}/${release.win.name}`
const macNote = `${release.mac.label} · ${mib(release.mac.size)} · ${release.tag}`
const winNote = `${release.win.label} · ${mib(release.win.size)} · ${release.tag}`

interface Ghost { href: string; label: string }
interface Props {
  rowClass?: string
  anchorId?: string
  installHref?: string
  noteLinks?: boolean
  ghost?: Ghost
  locale?: 'en' | 'vi'
  compact?: boolean
}
const { rowClass = 'ctas', anchorId, installHref, noteLinks = true, ghost, locale = 'en', compact = false } = Astro.props
const vi = locale === 'vi'
const NoteContainer = compact ? 'details' : 'div'
---
<div class={`${rowClass} download-options`} id={anchorId}>
  <a class="btn btn-accent" data-dl="macArm64" href={macHref}>{vi ? 'Tải cho macOS' : 'Download for macOS'}</a>
  <a class="btn btn-accent" data-dl="win" href={winHref}>{vi ? 'Tải cho Windows' : 'Download for Windows'}</a>
  {ghost && <a class="btn btn-ghost" href={ghost.href}>{ghost.label}</a>}
</div>
<NoteContainer class={compact ? 'download-details' : undefined}>
{compact && <summary>{vi ? 'Mac chip M · Windows 64-bit · Cách cài' : 'Apple Silicon Mac · Windows 64-bit · Install details'}</summary>}
<p class="cta-note">
  <span class="download-meta" data-dl-ver="macArm64">{macNote}</span>
  <span class="download-meta" data-dl-ver="win">{winNote}</span>
  {noteLinks && installHref && <><a href={installHref}>{vi ? 'Hướng dẫn cài (EN)' : 'Install help'}</a> · </>}
  {noteLinks && <a href={RELEASES}>{vi ? 'Các phiên bản' : 'All releases'}</a>}
</p>
</NoteContainer>
