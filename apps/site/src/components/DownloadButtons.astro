---
// The dual direct-download buttons plus their per-platform metadata lines.
// main.js (public/main.js) resolves each link to the GitHub latest release,
// keeping tag and filename paired per platform; the static hrefs are the
// pinned fallback when JS or the API is unavailable.
const MAC = 'https://github.com/cuongducle/oia/releases/download/v0.6.1/Oia-0.6.1-arm64.dmg'
const WIN = 'https://github.com/cuongducle/oia/releases/download/v0.6.1/Oia-0.6.1-win-x64.exe'

interface Ghost { href: string; label: string }
interface Props {
  rowClass?: string
  installHref?: string
  ghost?: Ghost
}
const { rowClass = 'ctas', installHref = 'install/', ghost } = Astro.props
---
<div class={`${rowClass} download-options`} id="download">
  <a class="btn btn-accent" data-dl="macArm64" href={MAC}>Download for macOS</a>
  <a class="btn btn-accent" data-dl="win" href={WIN}>Download for Windows</a>
  {ghost && <a class="btn btn-ghost" href={ghost.href}>{ghost.label}</a>}
</div>
<p class="cta-note">
  <span class="download-meta" data-dl-ver="macArm64">macOS (Apple Silicon) · 413 MiB · v0.6.1</span>
  <span class="download-meta" data-dl-ver="win">Windows 64-bit · 400 MiB · v0.6.1</span>
  <a href={installHref}>install help</a> · <a href="https://github.com/cuongducle/oia/releases">all releases</a>
</p>
