---
// Shared <head> for every page. Landing passes extra tags (og dimensions,
// twitter card, JSON-LD, the js-class bootstrap) through the default slot.
interface Props {
  title: string
  description: string
  canonical: string
  base: string
  ogTitle?: string
  ogDescription?: string
}
const { title, description, canonical, base, ogTitle = title, ogDescription = description } = Astro.props
---
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#0e0d1f">
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml">
<meta property="og:type" content="website">
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
<meta property="og:image" content="https://oia.solutions/assets/og-hero.png">
<meta property="og:url" content={canonical}>
<link rel="canonical" href={canonical}>
<meta name="msvalidate.01" content="068423ABF7218178C97F3CA9066255DC">
<!-- Cloudflare Web Analytics: cookieless, no personal data. The site token is public by design. -->
<script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "f06a0d4fd23440a19cfca9497cf20c8c"}'></script>
<!-- Self-hosted Plausible CE at analytics.oia.solutions: cookieless, no cookies, no personal data. -->
<script is:inline defer data-domain="oia.solutions" src="https://analytics.oia.solutions/js/script.js"></script>
<script is:inline>
  // Conversion goal "Download click": fires when a visitor clicks an app download button.
  document.addEventListener('click', function (e) {
    var a = e.target && e.target.closest ? e.target.closest('a[data-dl]') : null;
    if (a && window.plausible) {
      window.plausible('Download click', { props: { platform: a.getAttribute('data-dl') === 'macArm64' ? 'mac' : 'windows' } });
    }
  });
</script>
<link rel="stylesheet" href={`${base}fonts/fonts.css`}>
<link rel="stylesheet" href={`${base}styles.css`}>
<slot />
