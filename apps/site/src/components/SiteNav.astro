---
// One top bar for every page. Callers pass resolved relative hrefs so the
// landing (anchor links) and content pages (routed links, EN or VI tree)
// share identical structure; landing keeps its in-page anchors.
interface Props {
  locale?: 'en' | 'vi'
  landing?: boolean
  home: string
  templates: string
  blog: string
  examples: string
  faq: string
  alt: string
}
const { locale = 'en', landing = false, home, templates, blog, examples, faq, alt } = Astro.props
const vi = locale === 'vi'
const t = (en: string, vn: string) => vi ? vn : en
const current = landing ? './' : './'
---
<nav class={landing ? 'siteNav' : 'siteNav pageNav'} aria-label={t('Main', 'Điều hướng chính')}>
  <a class="brand" href={landing ? '#top' : home}><span class="o">◆ OIA</span></a>
  <div class="navlinks">
    <a href={examples}>{t('Examples', 'Xem mẫu')}</a>
    <a href={templates}>{t('Templates', 'Thư viện')}</a>
    <a href={blog}>Blog</a>
    <a href={faq}>{t('FAQ', 'Hỏi đáp')}</a>
  </div>
  <div class="navcta">
    <div class="language-switch" role="group" aria-label={t('Language', 'Ngôn ngữ')}>
      <a href={vi ? alt : current} lang="en" hreflang="en" aria-current={!vi ? 'page' : undefined}>EN</a>
      <a href={vi ? current : alt} lang="vi" hreflang="vi" aria-current={vi ? 'page' : undefined}>VI</a>
    </div>
    <a class="btn btn-accent" href="#download">{t('Download', 'Tải ứng dụng')}</a>
  </div>
</nav>
