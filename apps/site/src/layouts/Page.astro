---
import BaseHead from '../components/BaseHead.astro'

interface NavLink { href: string; label: string }
interface Props {
  title: string
  description: string
  ogTitle?: string
  ogDescription?: string
  canonical: string
  base?: string
  links?: NavLink[]
  footerLinks?: NavLink[]
}
const { title, description, ogTitle, ogDescription, canonical, base = '../', links = [], footerLinks = [] } = Astro.props
---
<!doctype html>
<html lang="en">
<head>
<BaseHead title={title} description={description} canonical={canonical} base={base} ogTitle={ogTitle} ogDescription={ogDescription}>
  <link rel="stylesheet" href={`${base}pages.css`}>
  <slot name="head" />
</BaseHead>
</head>
<body class="page">
<nav class="pageNav" aria-label="Main">
  <a class="brand" href={`${base}`}><span class="o">◆ OIA</span></a>
  <div class="links">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </div>
  <a class="btn btn-accent" href="#download">Download</a>
</nav>
<slot />
<footer class="pageFooter">
  <a class="brand" href={`${base}`}><span class="o">◆ OIA</span></a>
  <div class="links">
    {footerLinks.map((l) => <a href={l.href}>{l.label}</a>)}
  </div>
  <span class="meta">MIT · Oia, free &amp; open source</span>
</footer>
<script src={`${base}main.js`} defer></script>
</body>
</html>
