---
// Standalone on purpose: this page is served at ANY unmatched path (both by
// the Cloudflare worker and GitHub Pages), so relative URLs would resolve
// against the wrong depth. Inline styles + root-relative links only. On the
// github.io subpath mirror the links may miss; the primary origin is correct.
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Page not found | Oia</title>
<meta name="robots" content="noindex">
<style>
  body{margin:0;font-family:system-ui,sans-serif;background:#0e0d1f;color:#efeaf8;min-height:100vh;display:grid;place-items:center}
  main{max-width:560px;padding:48px 24px;text-align:left}
  .k{font-family:ui-monospace,monospace;font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:#a99cf3;margin:0 0 14px}
  h1{font-size:clamp(30px,6vw,44px);line-height:1.05;margin:0 0 14px}
  p{color:#b3afcc;line-height:1.6;margin:0 0 26px}
  a{display:inline-block;margin:0 10px 10px 0;padding:10px 18px;border-radius:8px;font-weight:600;font-size:14px;text-decoration:none}
  .a{background:#6647ec;color:#fff}
  .g{border:1px solid #3a3560;color:#efeaf8}
</style>
</head>
<body>
<main>
  <p class="k">404</p>
  <h1>That page isn't here.</h1>
  <p>The link is broken or the page moved. Everything real lives one click away.</p>
  <div>
    <a class="a" href="/">Back to oia.solutions</a>
    <a class="g" href="/templates/">Browse the templates</a>
  </div>
</main>
</body>
</html>
