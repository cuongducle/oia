---
import { byCategory } from '../../data/catalog'
import { CATEGORIES, STYLES, PACKS } from '../../data/taxonomy'
import Page from '../../layouts/Page.astro'
import TemplateCard from '../../components/TemplateCard.astro'
import TemplateFaq from '../../components/TemplateFaq.astro'
import DownloadButtons from '../../components/DownloadButtons.astro'

const count = (slug: string) => byCategory(slug).length
---
<Page
  title="Free editable design templates"
  description="Start from 35 bundled scenes: sales, product launches, menus, social posts, posters, decks and transparent live graphics. Opening a template uses no AI quota."
  ogTitle="Free editable design templates"
  ogDescription="Studio posters, livestream overlay presets and decks, every template is a real editable scene."
  canonical="https://oia.solutions/templates/"
  base="../"
>
<header class="pageHero">
  <p class="kicker">The bundled library · v0.6.1</p>
  <h1>Start with real artwork.<br>Make the words yours.</h1>
  <p class="lede">Start from 35 bundled scenes: sales, product launches, menus, social posts, posters, decks and transparent live graphics. Opening a template uses no AI quota.</p>
  <DownloadButtons rowClass="ctaRow" anchorId="download" installHref="../install/" ghost={{ href: '../templates/', label: 'All 35 templates' }} />
</header>

<main class="pageMain">
  <p class="catNote">35 real scenes across eight categories. Select any image for a full-size preview. Transparent livestream and overlay graphics are listed without photographic mockups.</p>
  <div class="catNav" role="group" aria-label="Template categories">
    {CATEGORIES.map(([slug, label]) => <a href={`${slug}/`}>{label} · {count(slug)}</a>)}
  </div>
  <div class="catNav" role="group" aria-label="Styles and packs">
    {STYLES.map(([slug, label]) => <a href={`styles/${slug}/`}>{label}</a>)}
    {PACKS.map(([slug, label]) => <a href={`packs/${slug}/`}>{label}</a>)}
  </div>

  {CATEGORIES.map(([slug, label]) => (
    <>
      <h2 class="catH" id={slug}><a href={`${slug}/`}>{label}</a> <span class="count">{count(slug)}</span></h2>
      {slug === 'livestream' && (
        <p class="catNote">Transparent compositing graphics for your own video. Safe-zone guides stay in the editor; the countdown is a static frame.</p>
      )}
      <div class="tplGrid">
        {byCategory(slug).map((item) => <TemplateCard item={item} base="../" />)}
      </div>
    </>
  ))}

  <TemplateFaq />
</main>
</Page>
