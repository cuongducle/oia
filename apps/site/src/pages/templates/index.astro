---
import catalog from '../../data/catalog.json'
import { CATEGORIES, STYLES, PACKS } from '../../data/taxonomy'
import Page from '../../layouts/Page.astro'
import TemplateCard from '../../components/TemplateCard.astro'
import DownloadButtons from '../../components/DownloadButtons.astro'

interface Entry { id: string; name: string; category: string; style: string | null; pack: string | null; width: number; height: number; image?: string }
const items = catalog as Entry[]

const byCategory = (slug: string) => items.filter((t) => t.category === slug)
const count = (slug: string) => byCategory(slug).length

const links = [
  { href: '../#workflow', label: 'How it works' },
  { href: '../prompts/', label: 'Prompt library' },
  { href: '../use-cases/flash-sale-banners/', label: 'Use cases' },
  { href: 'https://github.com/cuongducle/oia', label: 'GitHub' },
]
const footerLinks = [
  { href: '../', label: 'Home' },
  { href: '../prompts/', label: 'Prompt library' },
  { href: '../use-cases/flash-sale-banners/', label: 'Flash-sale banners' },
  { href: '../use-cases/livestream-overlays/', label: 'Livestream overlays' },
  { href: '../use-cases/presentations/', label: 'Presentations' },
]
---
<Page
  title="Free editable design templates"
  description="Start from 35 bundled scenes: sales, product launches, menus, social posts, posters, decks and transparent live graphics. Opening a template uses no AI quota."
  ogTitle="Free editable design templates"
  ogDescription="Studio posters, livestream overlay presets and decks, every template is a real editable scene."
  canonical="https://oia.solutions/templates/"
  base="../"
  links={links}
  footerLinks={footerLinks}
>
<header class="pageHero">
  <p class="kicker">The bundled library · v0.6.1</p>
  <h1>Start with real artwork.<br>Make the words yours.</h1>
  <p class="lede">Start from 35 bundled scenes: sales, product launches, menus, social posts, posters, decks and transparent live graphics. Opening a template uses no AI quota.</p>
  <DownloadButtons rowClass="ctaRow" installHref="../install/" ghost={{ href: '../templates/', label: 'All 35 templates' }} />
</header>

<main class="pageMain">
  <p class="catNote">35 real scenes across eight categories. Select any image for a full-size preview. Transparent livestream and overlay graphics are listed without photographic mockups.</p>
  <div class="catNav" role="group" aria-label="Template categories">
    {CATEGORIES.map(([slug, label]) => <a href={`${slug}/`}>{label} · {count(slug)}</a>)}
  </div>
  <div class="catNav" role="group" aria-label="Styles and packs">
    {STYLES.map(([slug, label]) => <a href={`styles/${slug}/`}>{label}</a>)}
    {PACKS.map(([slug, label]) => <a href={`packs/${slug}/`}>{label}</a>)}
  </div>

  {CATEGORIES.map(([slug, label]) => (
    <>
      <h2 class="catH" id={slug}><a href={`${slug}/`}>{label}</a> <span class="count">{count(slug)}</span></h2>
      {slug === 'livestream' && (
        <p class="catNote">Transparent compositing graphics for your own video. Safe-zone guides stay in the editor; the countdown is a static frame.</p>
      )}
      <div class="tplGrid">
        {byCategory(slug).map((item) => <TemplateCard item={item} base="../" />)}
      </div>
    </>
  ))}

  <section class="faq" style="margin-top:48px">
    <h2>From template to your next campaign</h2>
    <details><summary>Does opening a template spend image quota?</summary><p>No. The artwork ships with Oia. Opening a template, changing native text, arranging layers and exporting use no AI quota. Requesting new AI artwork uses your provider quota.</p></details>
    <details><summary>Are these real previews?</summary><p>Yes. Each preview is rendered from the bundled scene using the same Fabric canvas engine as the desktop app. The gallery shows complete compositions, not cropped stock photos. Photographic backgrounds are AI-generated; copy remains native text.</p></details>
    <details><summary>Can I save my own designs as templates?</summary><p>Yes. Use Share ▸ Publish as template in the editor to keep a reusable scene in your own library.</p></details>
  </section>
</main>
</Page>
