---
import catalog from '../../data/catalog.json'
import Page from '../../layouts/Page.astro'
import TemplateCard from '../../components/TemplateCard.astro'
import DownloadButtons from '../../components/DownloadButtons.astro'
import { CATEGORIES, STYLES, PACKS } from '../../data/taxonomy'

interface Entry { id: string; name: string; category: string; style: string | null; pack: string | null; width: number; height: number; image?: string }
const items = catalog as Entry[]

type Kind = 'category' | 'style' | 'pack'
interface Route { kind: Kind; slug: string; label: string }

function pageItems(route: Route): Entry[] {
  if (route.kind === 'category') return items.filter((t) => t.category === route.slug)
  if (route.kind === 'style') return items.filter((t) => t.style === route.slug)
  return items.filter((t) => t.pack === route.slug)
}

export function getStaticPaths() {
  const routes: { params: { slug: string }; props: { route: Route } }[] = []
  for (const [slug, label] of CATEGORIES) routes.push({ params: { slug }, props: { route: { kind: 'category', slug, label } } })
  for (const [slug, label] of STYLES) routes.push({ params: { slug: `styles/${slug}` }, props: { route: { kind: 'style', slug, label } } })
  for (const [slug, label] of PACKS) routes.push({ params: { slug: `packs/${slug}` }, props: { route: { kind: 'pack', slug, label } } })
  return routes
}

const { route } = Astro.props
const list = pageItems(route)
const base = route.kind === 'category' ? '../../' : '../../../'
const title = route.kind === 'category'
  ? `${route.label} templates`
  : `${route.label} ${route.kind === 'style' ? 'style templates' : 'template pack'}`
const description = route.kind === 'category'
  ? `${list.length} editable ${route.label.toLowerCase()} templates included in Oia v0.6.1. Real scenes, native text layers, no image quota needed to open or edit.`
  : `${list.length} real editable scenes from the ${route.label} collection, bundled with Oia v0.6.1. Choose a composition, change the copy, and export.`

const links = [
  { href: `${base}#workflow`, label: 'How it works' },
  { href: `${base}prompts/`, label: 'Prompt library' },
  { href: `${base}use-cases/flash-sale-banners/`, label: 'Use cases' },
  { href: 'https://github.com/cuongducle/oia', label: 'GitHub' },
]
const footerLinks = [
  { href: `${base}`, label: 'Home' },
  { href: `${base}prompts/`, label: 'Prompts' },
  { href: `${base}install/`, label: 'Install help' },
  { href: 'https://github.com/cuongducle/oia', label: 'GitHub' },
]
---
<Page
  title={title}
  description={description}
  ogTitle={`${title} | Oia`}
  ogDescription={description}
  canonical={`https://oia.solutions/templates/${route.kind === 'category' ? `${route.slug}/` : `${route.kind}s/${route.slug}/`}`}
  base={base}
  links={links}
  footerLinks={footerLinks}
>
<header class="pageHero">
  <p class="kicker">The bundled library · v0.6.1</p>
  <h1>{title}</h1>
  <p class="lede">{description}</p>
  <DownloadButtons rowClass="ctaRow" installHref={`${base}install/`} ghost={{ href: `${base}templates/`, label: 'All 35 templates' }} />
</header>

<main class="pageMain">
  <div class="tplGrid">
    {list.map((item) => <TemplateCard item={item} base={base} />)}
  </div>

  <section class="faq" style="margin-top:48px">
    <h2>From template to your next campaign</h2>
    <details><summary>Does opening a template spend image quota?</summary><p>No. The artwork ships with Oia. Opening a template, changing native text, arranging layers and exporting use no AI quota. Requesting new AI artwork uses your provider quota.</p></details>
    <details><summary>Are these real previews?</summary><p>Yes. Each preview is rendered from the bundled scene using the same Fabric canvas engine as the desktop app. The gallery shows complete compositions, not cropped stock photos. Photographic backgrounds are AI-generated; copy remains native text.</p></details>
    <details><summary>Can I save my own designs as templates?</summary><p>Yes. Use Share ▸ Publish as template in the editor to keep a reusable scene in your own library.</p></details>
  </section>
</main>
</Page>
