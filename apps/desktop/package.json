{
  "name": "@oia/desktop",
  "productName": "Oia",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "fetch-codex": "node scripts/fetch-codex.mjs",
    "smoke": "electron-vite build && cross-env OIA_DESKTOP_SMOKE=1 electron .",
    "crash-smoke": "electron-vite build && cross-env OIA_DESKTOP_CRASH_SMOKE=1 electron .",
    "shot": "electron-vite build && cross-env OIA_DESKTOP_SHOT=1 electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "dist:mac": "node scripts/fetch-codex.mjs && electron-vite build && electron-builder --mac",
    "dist:mac:dir": "node scripts/fetch-codex.mjs && electron-vite build && electron-builder --mac --dir"
  },
  "dependencies": {
    "@oia/canvas": "workspace:*",
    "@oia/protocol": "workspace:*",
    "@oia/providers": "workspace:*",
    "@oia/schema": "workspace:*",
    "@oia/services": "workspace:*",
    "@oia/tasks": "workspace:*",
    "fabric": "^7.4.0",
    "heic2any": "^0.0.4",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.4.299",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "cross-env": "^10.1.0",
    "electron": "39.8.10",
    "electron-builder": "26.18.0",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}